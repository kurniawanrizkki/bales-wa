        <mxCell id="node_db_sqlite" value="SQLite (app.db)&#xa;Database lokal terstruktur:&#xa;• users: Akun &amp; Token&#xa;• business_profiles: Toko&#xa;• products: Harga &amp; Stok&#xa;• chat_logs: Riwayat Chat" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#FEF3C7;strokeColor=#D97706;fontFamily=Plus Jakarta Sans;fontSize=10.5;fontColor=#92400E;strokeWidth=1.5;" vertex="1" parent="lane_owner">
