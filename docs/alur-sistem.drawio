  <diagram id="balaswa-flowchart" name="Alur Sistem BalasWA">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title Header -->
        <mxCell id="title" value="FLOWCHART ALUR SISTEM DAN INTEGRASI LAYANAN BALASWA UMKM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0F172A;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="1000" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Alur end-to-end dari pesan pelanggan WhatsApp masuk, filter konteks, integrasi AI 9Router, hingga balasan faktual dikirim" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#64748B;fontFamily=Plus Jakarta Sans;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="1000" height="25" as="geometry" />
        </mxCell>

        <!-- Swimlane 1: Pelanggan -->
        <mxCell id="lane_pelanggan" value="1. PELANGGAN (WHATSAPP)" style="swimlane;startSize=36;fontStyle=1;fontSize=12;fontFamily=Plus Jakarta Sans;fillColor=#FAF5FF;strokeColor=#D8B4FE;fontColor=#7E22CE;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="260" height="900" as="geometry" />
        </mxCell>
        <mxCell id="node_wa_user" value="1. Pesan Masuk&#xa;Pelanggan kirim pertanyaan via WA&#xa;(produk, stok, jam buka, rekening)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#0F172A;fontStyle=0;strokeWidth=2;" vertex="1" parent="lane_pelanggan">
          <mxGeometry x="25" y="60" width="210" height="65" as="geometry" />
        </mxCell>
        <mxCell id="node_receive_reply" value="8. Balasan Diterima&#xa;Pelanggan terima balasan akurat,&#xa;ramah, dan cepat (~1-2 detik)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#15803D;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_pelanggan">
          <mxGeometry x="25" y="500" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- Swimlane 2: WhatsApp Web Engine -->
        <mxCell id="lane_wa_engine" value="2. WA ENGINE (CHROMIUM)" style="swimlane;startSize=36;fontStyle=1;fontSize=12;fontFamily=Plus Jakarta Sans;fillColor=#F0F9FF;strokeColor=#BAE6FD;fontColor=#0369A1;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="290" height="900" as="geometry" />
        </mxCell>
        <mxCell id="node_wa_event" value="2. Event message_create&#xa;whatsapp-web.js + Chromium menangkap&#xa;nomor dan isi teks chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="lane_wa_engine">
          <mxGeometry x="30" y="60" width="230" height="65" as="geometry" />
        </mxCell>
        <mxCell id="node_filter_biz" value="Relevan Konteks Toko?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#92400E;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="lane_wa_engine">
          <mxGeometry x="60" y="160" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_drop_msg" value="Abaikan Pesan (Drop)&#xa;Abaikan grup, status, broadcast,&#xa;atau chat non-bisnis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontFamily=Plus Jakarta Sans;fontSize=10.5;fontColor=#B91C1C;strokeWidth=1.5;" vertex="1" parent="lane_wa_engine">
          <mxGeometry x="45" y="275" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="node_send_wa" value="7. client.sendMessage()&#xa;Chromium mengirim balasan langsung&#xa;ke nomor WhatsApp pelanggan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="lane_wa_engine">
          <mxGeometry x="30" y="500" width="230" height="65" as="geometry" />
        </mxCell>

        <!-- Swimlane 3: Core Backend & Logic -->
        <mxCell id="lane_backend" value="3. LOGIC &amp; CONTEXT BUILDER" style="swimlane;startSize=36;fontStyle=1;fontSize=12;fontFamily=Plus Jakarta Sans;fillColor=#FDF4FF;strokeColor=#F5D0FE;fontColor=#A21CAF;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="310" height="900" as="geometry" />
        </mxCell>
        <mxCell id="node_check_instant" value="3. Pola Balasan Instan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#92400E;fontStyle=1;strokeWidth=1.5;" vertex="1" parent="lane_backend">
          <mxGeometry x="70" y="160" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="node_instant_reply" value="Template Respon Instan&#xa;Format salam awal / order cepat dibalas&#xa;otomatis tanpa panggil LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontFamily=Plus Jakarta Sans;fontSize=10.5;fontColor=#0F172A;strokeWidth=1.5;" vertex="1" parent="lane_backend">
          <mxGeometry x="40" y="275" width="230" height="55" as="geometry" />
        </mxCell>
        <mxCell id="node_build_context" value="4. Context Builder&#xa;Merangkai prompt dinamis:&#xa;• Identitas toko, jam buka, rekening&#xa;• Katalog produk &amp; stok aktual&#xa;• 6 riwayat percakapan terakhir&#xa;• System prompt pemilik usaha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="lane_backend">
          <mxGeometry x="40" y="360" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- Swimlane 4: AI Gateway -->
        <mxCell id="lane_ai" value="4. 9ROUTER AI GATEWAY" style="swimlane;startSize=36;fontStyle=1;fontSize=12;fontFamily=Plus Jakarta Sans;fillColor=#F1F5F9;strokeColor=#CBD5E1;fontColor=#334155;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1000" y="120" width="270" height="900" as="geometry" />
        </mxCell>
        <mxCell id="node_call_ai" value="5. Inference AI&#xa;POST /v1/chat/completions&#xa;• Model: cx/gpt-5.6-terra&#xa;• Temp: 0.7 | Max: 600 token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="lane_ai">
          <mxGeometry x="25" y="380" width="220" height="65" as="geometry" />
        </mxCell>
        <mxCell id="node_ai_response" value="6. Jawaban Terstruktur&#xa;AI menghasilkan respon ramah berbasis&#xa;data nyata toko (tanpa halusinasi)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#15803D;fontStyle=1;strokeWidth=2;" vertex="1" parent="lane_ai">
          <mxGeometry x="25" y="490" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Swimlane 5: Pemilik Usaha -->
        <mxCell id="lane_owner" value="5. PEMILIK USAHA &amp; SQLITE" style="swimlane;startSize=36;fontStyle=1;fontSize=12;fontFamily=Plus Jakarta Sans;fillColor=#FFFBEB;strokeColor=#FDE68A;fontColor=#B45309;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1300" y="120" width="270" height="900" as="geometry" />
        </mxCell>
        <mxCell id="node_web_manage" value="Dashboard Web&#xa;Pemilik mengelola data via:&#xa;• /app/profile (Profil Toko)&#xa;• /app/products (Stok Produk)&#xa;• /app (QR WA &amp; Prompt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;fontFamily=Plus Jakarta Sans;fontSize=11;fontColor=#0F172A;strokeWidth=1.5;" vertex="1" parent="lane_owner">
          <mxGeometry x="25" y="60" width="220" height="80" as="geometry" />
